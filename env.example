# Headscale服务器URL（请修改为您的VPS公网IP或域名）
# 例如: http://your-vps-ip:9080 或 https://headscale.yourdomain.com
HEADSCALE_SERVER_URL=http://your-vps-ip:9080

# Headscale API端口（默认9080）
HEADSCALE_PORT=9080

# Headscale UI端口（默认9443）
UI_PORT=9443

# STUN端口（用于NAT穿透，默认3478）
STUN_PORT=3478

# Headscale API密钥（用于headscale-ui访问）
# 可以通过 headscale apikeys create 命令生成
HEADSCALE_API_KEY=your-api-key-here

